<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <!-- No INTERNET or broad storage permission: the ROM is selected with SAF. -->
    <application android:label="DKC1Recomp Mobile" android:theme="@style/AppTheme"
        android:icon="@drawable/ic_launcher" android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true" android:hasCode="true">
        <activity android:name=".LauncherActivity" android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Separate process: a new session never reuses stale core globals. -->
        <activity android:name=".GameActivity" android:exported="false"
            android:process=":game" android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|density|locale|layoutDirection"
            android:launchMode="singleTop" android:theme="@style/GameTheme" />
    </application>
</manifest>
