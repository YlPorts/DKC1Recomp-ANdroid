{
  "name": "dixie-jungle",
  "script": "../recipes/route_jungle.dks",
  "frames": 16000,
  "widescreen": false,
  "repeats": 3,
  "budgets": { "cache_oob": 0, "retrodict": 0 },
  "checkpoints": {
    "level_entry": {
      "expect": [
        { "addr": "0x003E", "op": "==", "value": "0x0016" },
        { "addr": "0x1B25", "op": ">=", "value": "0x0100" },
        { "addr": "0x088B", "op": "<=", "value": "0x0100" }
      ]
    },
    "camera_0200": {
      "expect": [{ "addr": "0x088B", "op": ">=", "value": "0x0200" }]
    }
  },
  "quickload": {
    "state_from": "mid_level.state",
    "script": "../recipes/route_jungle_quickload.dks",
    "frames": 9000,
    "widescreen": false,
    "budgets": { "cache_oob": 0, "retrodict": 0 },
    "checkpoints": {
      "quickload_settled": {
        "expect": [
          { "addr": "0x003E", "op": "==", "value": "0x0016" },
          { "addr": "0x1B25", "op": ">=", "value": "0x0100" },
          { "addr": "0x088B", "op": ">=", "value": "0x0200" }
        ]
      },
      "quickload_advanced": {
        "expect": [{ "addr": "0x088B", "op": ">=", "value": "0x0280" }]
      }
    }
  }
}
